<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.Leanback">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorAccent">#FFFF0033</item>
        <item name="rowHeaderStyle">@style/LtRowHeader</item>
        <item name="android:alertDialogTheme">@style/LtDialog</item>
    </style>

    <style name="LtRowHeader" parent="Widget.Leanback.Row.Header">
        <item name="android:textSize">19sp</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="LtDialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">#FFFF0033</item>
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="android:textColorPrimary">#FFFFFFFF</item>
    </style>

    <style name="PlayerTheme" parent="Theme.Leanback">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:colorAccent">#FFFF0033</item>
        <item name="android:alertDialogTheme">@style/LtDialog</item>
    </style>
</resources>
